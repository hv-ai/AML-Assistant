# Copy settings only if using manual setup. Prefer python3 configure.py.
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nebius generation and embedding models are separate.
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Run python3 configure.py --pinecone to save the key without echoing it.
PINECONE_API_KEY=
PINECONE_INDEX=aml-research
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
